# ============================================================
# AWS
# ============================================================
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Use temporary credentials locally when required.
# Never commit real credential values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ============================================================
# Amazon Bedrock AgentCore
# ============================================================
HARNESS_ARN=
HARNESS_LOG_GROUP=
POLICY_COMPLIANCE_EVALUATOR_ID=

# ============================================================
# DeepEval / Ollama
# ============================================================
DEEPEVAL_JUDGE_MODEL=mistral-nemo:12b
OLLAMA_BASE_URL=http://localhost:11434

# Saved-response file to evaluate, e.g.:
# results/baseline/golden_results_raw_972e97b8.json
# results/v2/golden_results_raw_6133af15.json
DEEPEVAL_RESULTS_PATH=

# Optional comma-separated subset, e.g. GD-001,GD-002,GD-003.
# Leave empty to evaluate all applicable cases.
DEEPEVAL_CASE_IDS=
